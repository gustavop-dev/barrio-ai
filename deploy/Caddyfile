# Caddy obtains and renews the certificate on its own. No ACME email is configured: Let's Encrypt
# stopped sending expiry emails in 2025. To add one, put a global options block with `email` at the top.
{$BARRIO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# The capture button records voice notes and takes photos from the PWA itself (same origin only).
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}

	# Uploads of the capture button and the Galería: 25 MB of audio + 10 photos of 10 MB, with margin.
	@uploads path /api/v1/capturas /api/v1/galeria
	request_body @uploads {
		max_size 130MB
	}

	# Conectar LinkedIn desde la app (agentes-linkedin/navegador/README.md «Conectar desde la app»): the remote view of
	# a login in progress, served by the navegador service only while it lasts. OFF unless LINKEDIN_CONEXION_APP=true
	# (the matcher compares that value at load time). Every request asks the backend first (forward_auth): only a browser
	# holding the cookie of a live login passes, and the backend's answer brings the view key that Caddy adds to the
	# request it passes on. The person's browser never sees that key; a header it sends under that name is dropped.
	@pantalla {
		path /conectar/*
		expression `"{$LINKEDIN_CONEXION_APP:false}" == "true"`
	}
	handle @pantalla {
		route {
			request_header -X-Pantalla-Clave
			forward_auth api:8787 {
				uri /api/v1/linkedin/pantalla/permitir
				copy_headers X-Pantalla-Clave
			}
			uri strip_prefix /conectar
			reverse_proxy navegador:8791
		}
	}

	@backend path /api/* /admin/* /static/* /health
	handle @backend {
		reverse_proxy api:8787
	}

	# The service worker and manifest must always be revalidated so updates reach the phone.
	@fresh path /sw.js /manifest.webmanifest /index.html
	header @fresh Cache-Control "no-cache"

	# Vite build output under /_app/ is content-hashed and never changes.
	@hashed path /_app/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
