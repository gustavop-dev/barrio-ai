# Servidor de Barrio AI. Copiar a .env (chmod 600). Nunca versionar .env.
BARRIO_DOMAIN=barrio.tudominio.com
# Versión de las imágenes publicadas por GitHub Actions: latest o el SHA de un commit (para volver atrás).
BARRIO_TAG=latest
POSTGRES_PASSWORD=generar-una-larga
DJANGO_SECRET_KEY=generar-una-muy-larga
DJANGO_ADMIN_USERNAME=gustavo
DJANGO_ADMIN_PASSWORD=generar-una-larga
# Organizaciones (docs/plan-organizaciones.md): la migración 0055 y bootstrap_local crean la organización ProjectApp y su
# primer miembro (administrador, dueño de las cuentas que ya existían): el usuario de REFERENTS_GUSTAVO_USERNAME si existe
# (por defecto «gustavo»), si no el primer superusuario humano. Después de eso la identidad vive en la base y esta variable
# ya no hace falta; solo cuenta en una instalación sin miembros. Los demás miembros: manage.py operador --usuario <admin> miembro.
# REFERENTS_GUSTAVO_USERNAME=gustavo
KNOWLEDGE_API_TOKEN=generar-uno-largo

# Presupuesto de IA: uno solo para todo el equipo (todos los proveedores y áreas juntos), por mes calendario en
# OPERATOR_TIMEZONE. AI_DAILY_FUSE_USD es un tope de seguridad diario contra gastos desbocados, no un tope por área.
AI_MONTHLY_LIMIT_USD=100
AI_DAILY_FUSE_USD=15
# Proveedores de IA (pagos). <PROVEEDOR>_LIMIT_USD es opcional: un techo mensual extra para un solo proveedor
# (vacío = solo el presupuesto general); <PROVEEDOR>_LIMIT_WINDOW=total lo vuelve acumulado desde el inicio.
LIVE_PROVIDERS=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_LIMIT_USD=
OPENAI_LIMIT_USD=
# Si Anthropic rechaza una llamada por cuenta o disponibilidad, la responde OpenAI (ARQ-10); off lo desactiva.
LLM_FALLBACK=openai
EMBEDDING_MODEL=text-embedding-3-small

# Transcripción de las notas de voz del botón de captura (agentes-linkedin/infra/docs/capturas-galeria.md).
# Pago por segundo de audio: 0,21 USD/h con Universal-3.5 Pro. Cuenta dentro de AI_MONTHLY_LIMIT_USD.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_LIMIT_USD=
ASSEMBLYAI_USD_PER_HOUR=0.21
# Archivos privados (audios y fotos) dentro del contenedor; es la ruta del volumen media: no cambiarla.
MEDIA_ROOT=/app/media

# LinkedIn directo (docs/plan-linkedin-directo.md): la cuenta opera por el servicio navegador. Apagado: el servicio navegador solo arranca con
# `--profile navegador` y el backend solo lo usa con LIVE_LINKEDIN_DIRECTO=true. El mismo token va a los dos lados
# (al menos 24 caracteres; generarlo con `openssl rand -hex 32`).
LIVE_LINKEDIN_DIRECTO=false
NAVEGADOR_URL=http://navegador:8790
NAVEGADOR_TOKEN=
# Topes por cuenta en ventanas móviles de 1 h y 24 h (vacío = estos valores; salen del ritmo real de un día, ver
# agentes-linkedin/navegador/README.md) y la pausa al azar antes de cada llamada, en segundos (mínimo 3). Un tope
# agotado no pausa la cuenta: la acción queda aprobada y se reintenta cuando hay cupo.
NAVEGADOR_LECTURAS_HORA=150
NAVEGADOR_LECTURAS_DIA=1000
NAVEGADOR_ESCRITURAS_HORA=15
NAVEGADOR_ESCRITURAS_DIA=100
# Por tipo de escritura y día: comentarios y respuestas, reacciones, seguimientos, invitaciones, aceptaciones.
NAVEGADOR_COMENTARIOS_DIA=30
NAVEGADOR_REACCIONES_DIA=30
NAVEGADOR_SEGUIMIENTOS_DIA=30
NAVEGADOR_INVITACIONES_DIA=30
NAVEGADOR_ACEPTACIONES_DIA=15
NAVEGADOR_PAUSA_MIN=3
NAVEGADOR_PAUSA_MAX=7
# El navegador de una cuenta abierto ocupa cerca de 1 GiB. Vacío o 0 = queda abierto (por defecto). Con minutos, se
# cierra tras ese tiempo sin llamadas y la siguiente lo abre otra vez, con una carga más del inicio que LinkedIn ve:
# solo compensa con varias cuentas en un servidor pequeño (el backend llama al menos cada hora).
NAVEGADOR_CIERRE_INACTIVO_MIN=
# Salida a internet del navegador (vacío = directo): esquema://servidor:puerto con http, https o socks5, sin
# credenciales en la dirección. NAVEGADOR_PROXY_CUENTAS da una propia por cuenta (cuenta=…,otra=directo). Usuario y
# clave van aparte, solo para http o https. Si la salida de una cuenta cambia, no se abre hasta aceptarlo con
# `python -m navegador salida <cuenta> --aceptar`: una sesión que salta de IP es lo que LinkedIn anula primero.
NAVEGADOR_PROXY=
NAVEGADOR_PROXY_CUENTAS=
NAVEGADOR_PROXY_USUARIO=
NAVEGADOR_PROXY_CLAVE=
# Conectar LinkedIn desde la app (Ajustes › Máquina; agentes-linkedin/navegador/README.md «Conectar desde la app»):
# entrar en LinkedIn en el navegador del servidor viéndolo desde el teléfono, sin túnel SSH. Apagado: con true se
# encienden a la vez el backend, el servicio navegador y la ruta /conectar/ de Caddy (hace falta `up -d` de web y
# navegador). La vista remota existe solo mientras dura una conexión, como mucho estos minutos (de 2 a 30).
LINKEDIN_CONEXION_APP=false
NAVEGADOR_CONEXION_MIN=10
# Prueba diaria de cada cuenta directo (backend): las 14 lecturas del conector, 16 llamadas, desde esta hora UTC.
LINKEDIN_CANARY_ENABLED=true
LINKEDIN_CANARY_AFTER=12:00
# Rodaje de la fase 4 (agentes-linkedin/navegador/README.md, «Rodaje»): UNA cuenta de prueba haciendo un día de
# producción por el servicio navegador, día tras día. Solo arranca con `--profile rodaje`; vacío = estos valores.
# Comentarios y respuestas, en 0: con un número hace falta RODAJE_TEXTOS, un archivo en el volumen con textos propios,
# uno por línea (cada uno sale una vez). RODAJE_LUGAR y RODAJE_BUSQUEDAS vacíos: «United States» y
# «founder,product manager,cto,software engineer».
RODAJE_CUENTA=
RODAJE_HORARIO=08:00-20:00
RODAJE_ZONA=America/Bogota
RODAJE_ESCALA=1
RODAJE_REACCIONES=6
RODAJE_SEGUIMIENTOS=4
RODAJE_INVITACIONES=2
RODAJE_ACEPTACIONES=5
RODAJE_COMENTARIOS=0
RODAJE_RESPUESTAS=0
RODAJE_TEXTOS=
RODAJE_LUGAR=
RODAJE_BUSQUEDAS=

# Máquina autónoma.
OPERATOR_AUTOPILOT=false
OPERATOR_AUTONOMY=INT-03=auto,INT-04=auto,INT-02=auto,CONT-09=auto,RED-01=auto,RED-02=auto,RED-04=auto
OPERATOR_WINDOW=07:00-21:00
OPERATOR_TIMEZONE=America/Bogota
# Ventana de lecturas en segundo plano (hora local de OPERATOR_TIMEZONE): fuera de ella el autopiloto no encola lecturas
# periódicas (comentarios de tus posts, bandeja, referentes, métricas, desenlaces, analítica, canario, red). Las
# escrituras, su conciliación y lo que pidas desde la app no esperan. Vacío = a cualquier hora, como antes.
READ_WINDOW=07:00-21:00
OPERATOR_MIN_SPACING_SECONDS=1200
# BAR-15: local product policy, not a guaranteed LinkedIn allowance. Never reset audit state.
# Organizaciones (fase 2): el ritmo es de cada miembro (sus cuentas lo comparten; dos miembros no). Un miembro puede tener
# sus propios OPERATOR_DAILY_LIMITS, OPERATOR_WEEKLY_LIMITS, OPERATOR_INVITE_RAMP_STAGES, OPERATOR_INVITE_RAMP_START,
# OPERATOR_PROFILE_READ_DAILY_LIMIT, LINKEDIN_ACCOUNT_TIER, LINKEDIN_INVITE_NOTE_MONTHLY_LIMIT, OPERATOR_AUTONOMY y
# EDITORIAL_POST_TIME: manage.py operador --usuario <admin> ajustes --miembro <usuario> --fijar VARIABLE=VALOR. Sin ellos,
# los de aquí. Los segundos de espaciado, la ventana y el gasto de IA son los mismos para todos.
OPERATOR_MAX_SPACING_SECONDS=2400
OPERATOR_WEEKEND_FACTOR=0.5
OPERATOR_PROFILE_READ_DAILY_LIMIT=80
OPERATOR_INVITE_RAMP_ENABLED=true
OPERATOR_INVITE_RAMP_STAGES=8/40,16/80,20/100
OPERATOR_INVITE_RAMP_MIN_DAYS=7
# Etapa con la que empieza la rampa de un miembro que aún no tiene (0, 1 o 2). Una rampa ya guardada no cambia.
OPERATOR_INVITE_RAMP_START=1
OPERATOR_INVITE_ACCEPTANCE_MIN=0.40
OPERATOR_INVITE_ACCEPTANCE_PAUSE=0.25
OPERATOR_INVITE_ACCEPTANCE_DROP_PP=10

# Organizaciones (fase 3): la voz de cada miembro (docs/funcionalidades/organizaciones.md#org-16). Un miembro sin documento
# de voz escribe con la voz provisional (neutra; sus borradores quedan marcados «voz provisional»). Con esto encendido,
# `manage.py operador --usuario <ella> voz --proponer` escribe una PROPUESTA de su documento desde sus señales (lo que
# aprobó, editó, rechazó y respondió): una sola llamada pagada con su reserva; solo se usa cuando ella la confirma
# (`voz --confirmar N`). Nunca es automático. Apagado: nada se propone y todo sigue igual.
VOICE_LEARNING_ENABLED=false
# Textos suyos aprobados sin cambios o editados que hacen falta antes de proponer (mínimo 1).
VOICE_LEARNING_MIN_TEXTS=12
OPERATOR_INVITE_SAMPLE_MIN=20
OPERATOR_INVITE_MATURITY_DAYS=7
OPERATOR_INVITE_COHORT_DAYS=28
# Declare known parallel outreach; true pauses outreach. Never run lemlist alongside this operator.
OPERATOR_EXTERNAL_OUTREACH_ACTIVE=false
# BAR-16: ordinary invitations have no note. Local cap; provider remaining balance is unknown.
LINKEDIN_ACCOUNT_TIER=free
LINKEDIN_INVITE_NOTE_MONTHLY_LIMIT=3
OPERATOR_PROPOSAL_TTL_HOURS=48
OPERATOR_MAX_POST_AGE_HOURS=72
OPERATOR_OBSERVE_EVERY_MINUTES=180
# INT-04 (docs/funcionalidades/respuestas.md): respuestas solas a quien comenta en los posts propios. Lee dentro de
# READ_WINDOW: el post más nuevo cada 2 h durante sus primeras REPLIES_NEWEST_HOURS; otro post de menos de 72 h cada 2 h
# mientras sus lecturas traigan comentarios y más espaciado (hasta REPLIES_IDLE_MAX_MINUTES) si no traen nada; de 72 h
# al día 7, cada 12 h. false lo apaga sin tocar OPERATOR_AUTONOMY.
REPLIES_ENABLED=true
REPLIES_FRESH_EVERY_MINUTES=120
REPLIES_LATE_EVERY_MINUTES=720
REPLIES_NEWEST_HOURS=48
# 240 = 2 h → 4 h. 480 da 2 h → 4 h → 8 h, pero un comentario en un post quieto puede esperar entonces al día siguiente.
REPLIES_IDLE_MAX_MINUTES=240
# Plazo para responder un comentario, contado desde el comentario.
REPLIES_WINDOW_HOURS=72
REPLIES_PIECES_PER_RUN=4
# Lecturas de LinkedIn por día: posts=6,comments=100,threads=40,people_posts=6 (vacío = esos valores). 100 es margen,
# no ritmo: el ritmo lo ponen la cadencia y el reparto del cupo a lo largo de READ_WINDOW (8 posts: unas 28 al día).
REPLIES_READ_CAPS=
OPERATOR_DAILY_PROPOSALS=20
OPERATOR_DAILY_LIMITS=INT-03=15,INT-04=10,INT-02=20,CONT-09=1,RED-01=20,RED-02=20,RED-04=10
OPERATOR_WEEKLY_LIMITS=INT-03=75,INT-04=40,INT-02=100,CONT-09=7,RED-01=100,RED-02=100,RED-04=40
OPERATOR_PAUSED=false
OPERATOR_ALLOW_FAKE=false

# Agente líder (docs/rediseno-backend.md): Jev (TypeSafe) aprueba o descarta cada acción en lugar de Gustavo.
LEAD_ENABLED=false
LEAD_CAPABILITIES=INT-03,CONT-09,RED-01,RED-02,RED-04
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
TYPESAFE_LIMIT_USD=

# Red del barrio (docs/red-barrio.md). Seguir, invitar sin nota y aceptar pasan por OPERATOR_AUTONOMY.
NETWORK_ENABLED=false
NETWORK_SEARCH_QUERIES=founder seed startup;cofounder startup AI;CTO startup;fundador startup [es];cofundador SaaS [es]
NETWORK_CLASSIFIER_MODEL=claude-sonnet-5-5
NETWORK_MIN_CONFIDENCE=0.6
NETWORK_INVITE_AFTER_HOURS=48
NETWORK_READ_CAPS=comments=60,search=20,profile=80,sync=4
# BAR-17 (12/11/2026): two network rounds, searches in the United States, buyers there with a seed round or later.
NETWORK_BATCHES=09:00-11:00,15:00-17:00
NETWORK_BATCH_SPACING_SECONDS=180-480
NETWORK_SEARCH_LOCATION=United States
NETWORK_SEARCHES_PER_RUN=2
# BAR-24 (17/11/2026): the region only orders, it takes nobody out: buyers in the United States first, then Latin
# America (those selling into the US first), then the rest. '' turns the order by region off.
NETWORK_BUYER_REGION=us
# The web check sets the buyer's level (confirmado, probable, por_confirmar, no_encaja) with the question of the buyer's
# profile, inside READ_WINDOW. Only evidence against (no_encaja) takes someone out; follows and invitations never wait.
NETWORK_STAGE_CHECK=true
NETWORK_STAGE_CHECKS_PER_DAY=6
# Soft weekly shares of the invitations by role (course table LI-03-V021-K03): whose turn it is, never how many go out
# (ramp and caps stay). A role without candidates gives its turn away; buyers first on a tie. `aliado` shares the
# recommenders' turn. '' turns the shares off (the order of red.plan as before).
NETWORK_ROLE_SHARE=comprador=20,recomendador+aliado=15,divulgador=20,par=25
# BAR-25 (17/11/2026), the ProjectApp buyer and the partner (docs/funcionalidades/red.md#bar-25). Off by default: off,
# classification, scores, searches and shares are exactly as before. On: a buyer gets a line (projectapp or startup), the
# ProjectApp buyer a segment, papel and size (score buyer_score_v2), the classifier may say `partner`, and the searches
# rotate by audience. The connector only filters by keywords, location and profile language ([es]): size, industry and
# hiring are judged by the classifier and the web check. Needs migration 0054.
NETWORK_PROJECTAPP_BUYER_ENABLED=false
NETWORK_SEARCH_QUERIES_PROJECTAPP=CTO retail;Director of IT ecommerce;Head of Technology online education;Owner online academy;VP Engineering retail;CEO family business;dueño de empresa [es];gerente de sistemas [es]
NETWORK_SEARCH_QUERIES_PARTNER=marketing agency founder development partners;design agency owner web development;digital agency white label development;product consultancy founder;agencia de marketing [es]
# Searches per audience (the startup one is NETWORK_SEARCH_QUERIES), inside NETWORK_SEARCHES_PER_RUN and the search cap.
NETWORK_SEARCH_AUDIENCE_SHARE=projectapp=28,startup=12,partner=12
# On, NETWORK_ROLE_SHARE defaults to the line below when unset; set here, change it together with the switch (`partner`
# and `comprador_*` are a configuration error with the switch off):
# NETWORK_ROLE_SHARE=comprador_projectapp=28,comprador_startup=12,partner=12,recomendador+aliado=8,par=10,divulgador=10
NETWORK_LEAD_REST_DAYS=30
NETWORK_DISCOVER_EVERY_MINUTES=360
NETWORK_SYNC_EVERY_MINUTES=360

# Outbound phase 2, the buyer's warm-up (docs/funcionalidades/red.md#bar-19). Off by default: off, everything is as before.
# Turn on only after the deploy with the classes 07 and 10 loaded (knowledge ingest); see the turn-on order in BAR-19.
# Caps and ramp do not change: comments still count against INT-03 and invitations against RED-02 and its ramp.
BUYER_WARMUP_ENABLED=false
BUYER_WARMUP_COMMENTS=2
BUYER_WARMUP_MAX_DAYS=14
BUYER_POST_MAX_AGE_HOURS=168
BUYER_POSTS_READ_DAILY_LIMIT=8
BUYER_POSTS_REREAD_HOURS=72
BUYER_NO_POSTS_READS=2
BUYER_REST_AFTER_DAYS=21
BUYER_REST_DAYS=60
BUYER_COMMENT_SHARE=compradores=8,comunidad=2,referentes=5

# Outbound phase 3, the first message on acceptance and the note for warmed buyers (docs/funcionalidades/red.md#bar-20).
# Off by default: off, RSP-07 is the only first message and the classifier's note works as before. Needs the lead on
# (LEAD_ENABLED) and class 09 loaded. The app never sends a private message: the first message is a draft Gustavo sends.
BUYER_FIRST_MESSAGE_ENABLED=false
# Days after the acceptance for a buyer who did not interact (one more touch first); clamped to 1–21.
BUYER_FIRST_MESSAGE_AFTER_DAYS=7

# Outbound phase 4, messages 2 to 4 to a buyer who did not reply (docs/funcionalidades/red.md#bar-21). Off by default:
# off, the journey ends at the first message (phase 3). Needs phase 3 (BUYER_FIRST_MESSAGE_ENABLED), the lead
# (LEAD_ENABLED) and the inbox (INBOX_ENABLED): without a recent inbox read nothing is prepared. Always drafts Gustavo sends.
BUYER_SEQUENCE_ENABLED=false
# Days from the «Hecho, le escribí» of message n-1 to message n, for n = 2, 3, 4 (each clamped to 1–30).
BUYER_SEQUENCE_DAYS=4,5,7
# Days after message 4 without a reply until she rests (1–60), and how long she rests (7–365).
BUYER_SEQUENCE_REST_AFTER_DAYS=7
BUYER_SEQUENCE_REST_DAYS=90
# A follow-up is prepared only after an inbox read this recent, in hours (1–24).
BUYER_SEQUENCE_INBOX_FRESH_HOURS=3
# A follow-up overdue by more than this many days is not written late; she rests instead (1–90).
BUYER_SEQUENCE_MAX_LATE_DAYS=14

# Outbound phase 5, the route of the buyer who does not post and the retries (docs/funcionalidades/red.md#bar-22). Off
# by default: off, everything is as in phases 2-4. Needs the warm-up (BUYER_WARMUP_ENABLED); the note and the first
# message also need phase 3. Finds a colleague who posts (the bridge) by his company, warms and invites it; the rest
# with fewer comments, the bridge before the rest, the angle of each retry and one web re-check when a rest ends.
BUYER_NO_POSTS_ROUTE_ENABLED=false
# People searches for bridges a day (0-10), inside the network «search» read cap.
BUYER_BRIDGE_SEARCHES_PER_DAY=2
# Profile reads per search, only for a result without a headline (0-5), inside OPERATOR_PROFILE_READ_DAILY_LIMIT.
BUYER_BRIDGE_PROFILES_PER_SEARCH=3
# Days the rest waits for the bridge (asked, or found and in course) before the buyer rests anyway (7-60).
BUYER_BRIDGE_WAIT_DAYS=21
# A buying signal this recent, in days, makes a buyer of this route a candidate for one of the month's notes (7-180).
BUYER_SIGNAL_RECENT_DAYS=30

# Outbound phase 6, her reply, the meeting and the lead's handoff (docs/funcionalidades/red.md#bar-23). Off by default:
# off, everything is as in phases 1-5 (her reply stops the sequence and nothing else). Needs phase 4
# (BUYER_SEQUENCE_ENABLED, with phase 3, the lead and the inbox). Classifies her reply (Jev), drafts the answer Gustavo
# sends by hand, matches the Cal.com booking and hands the lead over without qualifying it (the sales machine's).
BUYER_REPLY_ENABLED=false
# A type needs this probability (0.5-0.99) and this lead over the next one (0-0.9); else «otro» (a card, no draft).
BUYER_REPLY_MIN=0.7
BUYER_REPLY_MARGIN=0.2
# Gustavo's Cal.com booking page (https). Each buyer's link adds ?metadata[barrio]=<her id> so the booking matches her.
# Empty: no reply that needs the link is drafted (interesado, pide_informacion) and Slack says so once a day.
CALCOM_BOOKING_URL=
# The secret set on the Cal.com webhook (Settings → Developer → Webhooks), for POST /api/v1/comprador/calcom/webhook
# with BOOKING_CREATED, BOOKING_RESCHEDULED and BOOKING_CANCELLED. Empty: every call is rejected (403).
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CALCOM_WEBHOOK_SECRET=

# Publicación diaria con la API oficial de LinkedIn (agentes-linkedin/infra/docs/publicacion-diaria.md).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://barrio.tudominio.com/api/v1/linkedin/oauth/callback
LINKEDIN_API_VERSION=202610
LIVE_LINKEDIN_OFFICIAL=false
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
EDITORIAL_POST_TIME=08:30
EDITORIAL_LEAD_HOURS=12
# Una preparación con imágenes reserva unos 3 USD: con menos presupuesto disponible espera en vez de quedar a medias.
EDITORIAL_PREPARE_MIN_USD=3
# Compuertas (docs/compuertas.md): un día que una compuerta bloqueó tiene un segundo intento si quedan al menos estos
# minutos antes de su hora. COMPUERTAS_DURAS añade categorías del verificador que siempre bloquean (p. ej. other).
EDITORIAL_DAY_ATTEMPTS=2
EDITORIAL_RETRY_MIN_MINUTES=90
COMPUERTAS_DURAS=
# Un comentario que el líder descartó se reescribe una vez con sus razones (false lo apaga).
COMMENT_LEAD_REDRAFT=true
# Aviso «una compuerta frena demasiado»: tasa de parada a 7 días y mínimo de decisiones; false apaga los avisos.
COMPUERTAS_ALERTA_TASA=0.5
COMPUERTAS_ALERTA_MIN=4
COMPUERTAS_ALERTAS=true
# Un post que pide para un día sin hora sale como post extra a esta hora local (urgente.py).
EDITORIAL_EXTRA_TIME=12:00
# Estrategia semanal GASP (docs/plan-estrategia-semanal.md): el tipo de cada día, lunes primero; cada N semanas el G del
# domingo pasa a ser un segundo S (0: nunca). El domingo después de la hora local el director planea la semana
# siguiente con su propio tope semanal de IA. Un post P sin material suyo cuenta una historia pública con fuente de un
# founder (una investigación web) y no la repite en STRATEGY_STORY_REPEAT_WEEKS semanas. false apaga plan y tipos.
STRATEGY_ENABLED=true
STRATEGY_WEEK_TEMPLATE=G,A,G,A,S,P,G
STRATEGY_SALES_DOUBLE_EVERY=2
STRATEGY_PLAN_TIME=16:00
STRATEGY_PLAN_LLM_USD=1
STRATEGY_STORY_REPEAT_WEEKS=12
# Referentes de industria (docs/plan-referentes-industria.md): la búsqueda solo corre a mano
# (operador referentes-industria --confirmar) con este tope por búsqueda; los modelos de crecimiento no hacen llamadas
# pagadas y leen como mucho estos hilos de comentarios al día.
REFERENTES_INDUSTRIA_TOPE_USD=3
MODELOS_LECTURAS_DIA=4
# Qué les funciona a los referentes de industria (analisis_referentes.py, GET /api/v1/referentes/analisis): reglas fijas,
# sin llamadas pagadas ni lecturas de LinkedIn. Encendido, el editorial recibe además las estructuras sostenidas y los
# temas en tendencia (apagado: lo mismo que antes). Umbrales en docs/plan-referentes-industria.md.
REFERENTES_ANALISIS=false

# Notificaciones push de la PWA: python manage.py vapid_claves
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Push nativa de la app móvil por Expo (agentes-linkedin/infra/docs/app-movil-backend.md): gratis y sin cuenta.
# Opcional: solo si se activa la «seguridad de push mejorada» en el proyecto de Expo.
EXPO_ACCESS_TOKEN=
# Opcional, además de las push: ntfy o webhook compatible con Slack.
OPERATOR_ALERT_WEBHOOK=
# Avisos a Slack (team_backend/alertas_slack.py). Webhook entrante: en Slack, Aplicaciones › Incoming Webhooks › Añadir
# a Slack › elegir el canal › copiar la «Webhook URL» aquí. Es un secreto: nunca en tickets ni en el repositorio.
# Vacío = sin avisos y sin errores. SLACK_WEBHOOK_RESUMEN lleva los resúmenes a otro canal (vacío = al de alertas).
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_RESUMEN=
# Resumen diario al cierre de READ_WINDOW (canal de resúmenes): comentarios recibidos, respondidos y pendientes, lo que
# salió, gasto de IA, fallos y avisos del día, y cada cupo usado/tope. false lo apaga.
SLACK_DAILY_SUMMARY=true
# Aviso cuando un cupo diario de lecturas llega a esta fracción, y otro cuando se agota (una vez al día cada uno);
# la misma fracción vale para el gasto de IA del mes (AI_MONTHLY_LIMIT_USD), una vez al mes.
ALERT_CAP_THRESHOLD=0.8
# Horas de ventana que un comentario que merece respuesta espera sin respuesta publicada antes del aviso (una vez).
ALERT_REPLY_PENDING_HOURS=4
# Horas de ventana sin leer los comentarios de tus posts, con alguno esperando su lectura, antes del aviso (una vez al día).
ALERT_READS_GAP_HOURS=3
# Minutos que un trabajo puede esperar en cola sin que su worker empiece ninguno antes del aviso (por carril).
ALERT_QUEUE_STUCK_MINUTES=20
# Escrituras que el navegador deja sin salir (503) en una hora antes del aviso «el navegador no responde».
ALERT_NAVEGADOR_DEFERRALS=3
# Propuestas que solo apruebas tú (OPERATOR_AUTONOMY=approval) y caducan dentro de estas horas: un aviso agrupado al día.
ALERT_PROPOSAL_EXPIRY_HOURS=12
# «No pasó lo esperado» (una vez al día): el post del día no salió estos minutos después de EDITORIAL_POST_TIME; ningún
# comentario en posts de otros en estas horas de OPERATOR_WINDOW (con referentes activos); el líder descartó más de esta
# fracción de lo que revisó hoy, con al menos ALERT_LEAD_DISCARD_MIN revisiones. Un día laborable con la rampa en marcha
# que cierra sin invitaciones avisa al cierre de la ventana, sin variable.
ALERT_POST_LATE_MINUTES=60
ALERT_NO_COMMENTS_HOURS=24
ALERT_LEAD_DISCARD_RATIO=0.8
ALERT_LEAD_DISCARD_MIN=5
