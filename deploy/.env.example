# Servidor de Barrio AI. Copiar a .env (chmod 600). Nunca versionar .env.
BARRIO_DOMAIN=barrio.tudominio.com
# Versión de las imágenes publicadas por GitHub Actions: latest o el SHA de un commit (para volver atrás).
BARRIO_TAG=latest
POSTGRES_PASSWORD=generar-una-larga
DJANGO_SECRET_KEY=generar-una-muy-larga
DJANGO_ADMIN_USERNAME=gustavo
DJANGO_ADMIN_PASSWORD=generar-una-larga
KNOWLEDGE_API_TOKEN=generar-uno-largo

# Presupuesto de IA: uno solo para todo el equipo (todos los proveedores y áreas juntos), por mes calendario en
# OPERATOR_TIMEZONE. AI_DAILY_FUSE_USD es un tope de seguridad diario contra gastos desbocados, no un tope por área.
AI_MONTHLY_LIMIT_USD=100
AI_DAILY_FUSE_USD=15
# Proveedores de IA (pagos). <PROVEEDOR>_LIMIT_USD es opcional: un techo mensual extra para un solo proveedor
# (vacío = solo el presupuesto general); <PROVEEDOR>_LIMIT_WINDOW=total lo vuelve acumulado desde el inicio.
LIVE_PROVIDERS=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_LIMIT_USD=
OPENAI_LIMIT_USD=
EMBEDDING_MODEL=text-embedding-3-small

# Transcripción de las notas de voz del botón de captura (agentes-linkedin/infra/docs/capturas-galeria.md).
# Pago por segundo de audio: 0,21 USD/h con Universal-3.5 Pro. Cuenta dentro de AI_MONTHLY_LIMIT_USD.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_LIMIT_USD=
ASSEMBLYAI_USD_PER_HOUR=0.21
# Archivos privados (audios y fotos) dentro del contenedor; es la ruta del volumen media: no cambiarla.
MEDIA_ROOT=/app/media

# LinkedIn mediante Unipile.
LIVE_LINKEDIN=false
UNIPILE_API_KEY=

# Máquina autónoma.
OPERATOR_AUTOPILOT=false
OPERATOR_AUTONOMY=INT-03=auto,INT-02=auto,CONT-09=auto,RED-01=auto,RED-02=auto,RED-04=auto
OPERATOR_WINDOW=07:00-21:00
OPERATOR_TIMEZONE=America/Bogota
OPERATOR_MIN_SPACING_SECONDS=1200
# BAR-15: local product policy, not a guaranteed LinkedIn allowance. Never reset audit state.
OPERATOR_MAX_SPACING_SECONDS=2400
OPERATOR_WEEKEND_FACTOR=0.5
OPERATOR_PROFILE_READ_DAILY_LIMIT=80
OPERATOR_INVITE_RAMP_ENABLED=true
OPERATOR_INVITE_RAMP_STAGES=5/20,10/50,20/100
OPERATOR_INVITE_RAMP_MIN_DAYS=7
OPERATOR_INVITE_ACCEPTANCE_MIN=0.40
OPERATOR_INVITE_ACCEPTANCE_PAUSE=0.25
OPERATOR_INVITE_ACCEPTANCE_DROP_PP=10
OPERATOR_INVITE_SAMPLE_MIN=20
OPERATOR_INVITE_MATURITY_DAYS=7
OPERATOR_INVITE_COHORT_DAYS=28
# Declare known parallel outreach; true pauses outreach. Never run lemlist alongside this operator.
OPERATOR_EXTERNAL_OUTREACH_ACTIVE=false
# BAR-16: ordinary invitations have no note. Local cap; provider remaining balance is unknown.
LINKEDIN_ACCOUNT_TIER=free
LINKEDIN_INVITE_NOTE_MONTHLY_LIMIT=3
OPERATOR_PROPOSAL_TTL_HOURS=48
OPERATOR_MAX_POST_AGE_HOURS=72
OPERATOR_OBSERVE_EVERY_MINUTES=180
OPERATOR_DAILY_PROPOSALS=6
OPERATOR_DAILY_LIMITS=INT-03=5,INT-02=20,CONT-09=1,RED-01=10,RED-02=20,RED-04=10
OPERATOR_WEEKLY_LIMITS=INT-03=25,INT-02=100,CONT-09=7,RED-01=50,RED-02=100,RED-04=40
OPERATOR_PAUSED=false
OPERATOR_ALLOW_FAKE=false

# Agente líder (docs/rediseno-backend.md): Jev (TypeSafe) aprueba o descarta cada acción en lugar de Gustavo.
LEAD_ENABLED=false
LEAD_CAPABILITIES=INT-03,CONT-09,RED-01,RED-02,RED-04
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
TYPESAFE_LIMIT_USD=

# Red del barrio (docs/red-barrio.md). Seguir, invitar sin nota y aceptar pasan por OPERATOR_AUTONOMY.
NETWORK_ENABLED=false
NETWORK_SEARCH_QUERIES=founder pre-seed;cofounder startup AI;fundador startup;CTO startup
NETWORK_CLASSIFIER_MODEL=claude-sonnet-5-5
NETWORK_MIN_CONFIDENCE=0.6
NETWORK_INVITE_AFTER_HOURS=48
NETWORK_READ_CAPS=comments=60,search=20,profile=80,sync=4
NETWORK_DISCOVER_EVERY_MINUTES=360
NETWORK_SYNC_EVERY_MINUTES=360

# Publicación diaria con la API oficial de LinkedIn (agentes-linkedin/infra/docs/publicacion-diaria.md).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://barrio.tudominio.com/api/v1/linkedin/oauth/callback
LINKEDIN_API_VERSION=202610
LIVE_LINKEDIN_OFFICIAL=false
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
EDITORIAL_POST_TIME=08:30
EDITORIAL_LEAD_HOURS=12
# Una preparación con imágenes reserva unos 3 USD: con menos presupuesto disponible espera en vez de quedar a medias.
EDITORIAL_PREPARE_MIN_USD=3

# Notificaciones push de la PWA: python manage.py vapid_claves
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Push nativa de la app móvil por Expo (agentes-linkedin/infra/docs/app-movil-backend.md): gratis y sin cuenta.
# Opcional: solo si se activa la «seguridad de push mejorada» en el proyecto de Expo.
EXPO_ACCESS_TOKEN=
# Opcional, además de las push: ntfy o webhook compatible con Slack.
OPERATOR_ALERT_WEBHOOK=
