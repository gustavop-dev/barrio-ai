POSTGRES_PASSWORD=generate-a-local-password
KNOWLEDGE_API_TOKEN=generate-a-local-token
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Explicit switch for paid requests. Local ingestion, search and previews work without it.
LIVE_PROVIDERS=false
EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_MODEL=claude-opus-5-5
# Output cap per generation (thinking included). Reservations scale with it.
ANTHROPIC_MAX_TOKENS=8000
# Independent infrastructure pilot ceilings; NOT the old course processing budget.
OPENAI_LIMIT_USD=1
ANTHROPIC_LIMIT_USD=1
# Absolute directory containing the original classes and agentes-linkedin.
SOURCE_ROOT=/absolute/path/to/linkedin
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_ADMIN_USERNAME=gustavo
DJANGO_ADMIN_PASSWORD=generate-a-local-admin-password
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Enable only behind correctly configured HTTPS hosting.
DJANGO_HTTPS=false
# Private Sites office, outbound-only bridge. Never add these to frontend code.
OFFICE_SITE_URL=https://your-office.chatgpt.site
OFFICE_BRIDGE_TOKEN=
OFFICE_SITE_ACCESS_TOKEN=
# Account operator (LinkedIn). Writes run only when LIVE_LINKEDIN=true and an action was approved.
LIVE_LINKEDIN=false
UNIPILE_API_KEY=
# Autonomous machine (decision 2026-11-06). The autopilot service only enqueues work.
OPERATOR_AUTOPILOT=false
# Mode per capability: auto (policy approval) | approval (human) | off.
OPERATOR_AUTONOMY=INT-03=auto,INT-02=auto,CONT-09=auto
OPERATOR_WINDOW=07:00-21:00
OPERATOR_TIMEZONE=America/Bogota
OPERATOR_MIN_SPACING_SECONDS=1200
# BAR-15: local product policy, not a guaranteed LinkedIn allowance. Never reset audit state.
OPERATOR_MAX_SPACING_SECONDS=2400
OPERATOR_WEEKEND_FACTOR=0.5
OPERATOR_PROFILE_READ_DAILY_LIMIT=80
OPERATOR_INVITE_RAMP_ENABLED=true
OPERATOR_INVITE_RAMP_STAGES=5/20,10/50,20/100
OPERATOR_INVITE_RAMP_MIN_DAYS=7
OPERATOR_INVITE_ACCEPTANCE_MIN=0.40
OPERATOR_INVITE_ACCEPTANCE_PAUSE=0.25
OPERATOR_INVITE_ACCEPTANCE_DROP_PP=10
OPERATOR_INVITE_SAMPLE_MIN=20
OPERATOR_INVITE_MATURITY_DAYS=7
OPERATOR_INVITE_COHORT_DAYS=28
# Declare known parallel outreach; true pauses outreach. Never run lemlist alongside this operator.
OPERATOR_EXTERNAL_OUTREACH_ACTIVE=false
# BAR-16: ordinary invitations have no note. Local cap; provider remaining balance is unknown.
LINKEDIN_ACCOUNT_TIER=free
LINKEDIN_INVITE_NOTE_MONTHLY_LIMIT=3
OPERATOR_PROPOSAL_TTL_HOURS=48
OPERATOR_MAX_POST_AGE_HOURS=72
OPERATOR_OBSERVE_EVERY_MINUTES=180
OPERATOR_DAILY_PROPOSALS=6
OPERATOR_DAILY_LLM_USD=1
# BAR-15 ceilings; invitations remain subordinate to the persisted health ramp.
OPERATOR_DAILY_LIMITS=INT-03=5,INT-02=20,CONT-09=1,RED-01=10,RED-02=20,RED-04=10
OPERATOR_WEEKLY_LIMITS=INT-03=25,INT-02=100,CONT-09=7,RED-01=50,RED-02=100,RED-04=40
# ntfy topic URL or Slack-compatible webhook for pauses and stops.
OPERATOR_ALERT_WEBHOOK=
# Global kill switch: true stops every external write.
OPERATOR_PAUSED=false
# In-memory connector for local rehearsals only.
OPERATOR_ALLOW_FAKE=false
# Official LinkedIn API for own posts (docs/publicacion-diaria.md). Publishing only with LIVE_LINKEDIN_OFFICIAL=true.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-domain/api/v1/linkedin/oauth/callback
LINKEDIN_API_VERSION=202610
LIVE_LINKEDIN_OFFICIAL=false
# Fernet key(s) for the OAuth token at rest; comma-separated for rotation (first encrypts).
FIELD_ENCRYPTION_KEY=
# Daily own publication: local hour (OPERATOR_TIMEZONE, inside OPERATOR_WINDOW), preparation lead and daily LLM cap.
EDITORIAL_POST_TIME=08:30
EDITORIAL_LEAD_HOURS=12
EDITORIAL_DAILY_LLM_USD=1
# Metrics (docs/metricas-resultados.md): own-post snapshots at 24 h/72 h/7 d and the daily audience, read through Unipile.
METRICS_EVERY_MINUTES=180
METRICS_MAX_AGE_DAYS=30
METRICS_POSTS_LIMIT=20
METRICS_PROFILE_VIEWS_DAYS=28
METRICS_READ_CAPS=
# Inbox (docs/conversaciones-inbox.md): read-only; Jev proposes conversations to Gustavo in Tu turno. Off by default.
INBOX_ENABLED=false
# Bandejas de LinkedIn que se leen (Unipile «List inbox Chats»; v2 no tiene «List all Chats» para LinkedIn).
# Una página de empresa añade COMPANY_<id>_PRIMARY.
INBOX_IDS=CLASSIC_PRIMARY
INBOX_EVERY_MINUTES=60
INBOX_MAX_AGE_DAYS=14
INBOX_THREADS_PER_RUN=5
INBOX_READ_CAPS=chats=24,messages=60
INBOX_OPPORTUNITY_MIN=0.6
INBOX_REPLY_MIN=0.6
INBOX_PITCH_MAX=0.4
# Weekly results summary (docs/resumen-semanal.md): Monday after the local hour, for the week that ended; own weekly LLM cap.
WEEKLY_SUMMARY_ENABLED=true
WEEKLY_SUMMARY_TIME=07:30
WEEKLY_SUMMARY_LLM_USD=1

NETWORK_READ_CAPS=comments=60,search=20,profile=80,sync=4
