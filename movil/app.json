      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#f7f6f0"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "0ff1ce usa el micrófono solo mientras grabas un audio para el equipo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "0ff1ce abre tus fotos solo para adjuntar las que elijas a una captura.",
